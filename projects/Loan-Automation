      font-family: Arial, sans-serif;
      line-height: 1.7;
    }
    a { color: var(--lime); text-decoration: none; }
    .container { width: min(900px, 90%); margin: auto; }
    header { padding: 24px 0; border-bottom: 1px solid #ffffff18; }
    .nav { display: flex; justify-content: space-between; gap: 15px; }

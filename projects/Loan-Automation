      margin: 25px 0;
    }
    .step {
      border-left: 2px solid var(--blue);
      padding: 5px 0 5px 20px;
      margin: 20px 0;
    }
    .step strong { color: var(--text); }
    footer {
      border-top: 1px solid #ffffff18;
      margin-top: 45px;

    }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .panel {
      background: var(--surface);
      border: 1px solid #ffffff12;
      padding: 22px;
      border-radius: 10px;
    }
    .meta strong { display: block; color: var(--blue); }
    .panel h3 { margin-top: 0; }
